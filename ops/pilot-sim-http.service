[Unit]
Description=Pilot Sim static HTTP server
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/pilot-sim
ExecStart=/usr/bin/python3 -m http.server 18082 --bind 127.0.0.1 --directory /home/ubuntu/pilot-sim/public
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
UMask=0022

[Install]
WantedBy=default.target
