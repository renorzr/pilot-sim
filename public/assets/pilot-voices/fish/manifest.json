  "scripts": {
    "normal": {
      "title": "普通通话",
      "body": "塔台，云际三二零，跑道一七左，准备起飞。起飞后保持跑道方向，爬升至三千英尺。"
    },
    "mayday": {
      "title": "紧急呼叫",
      "unit": "Mayday.",
      "prefix": "MAYDAY, MAYDAY, MAYDAY.",
      "body": "塔台，云际三二零，双发失效，无法保持高度，请求紧急着陆。"
    },
    "pan": {
      "title": "优先着陆",
      "unit": "Pan pan.",
      "prefix": "PAN PAN, PAN PAN, PAN PAN.",
      "body": "塔台，云际三二零，襟翼卡阻，请求优先着陆。"
    }
  },
